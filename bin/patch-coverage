#!/usr/bin/env python3
# Count a layer's patch from the package's lcov the way codecov counts it: of the lines the
# layer adds under frontend-base/src, which are hit, which are missed, and which are partial
# (a line with a branch that no test takes). Run the package's tests with coverage first.
#
#   patch-coverage <repo> <base-ref> <head-ref> <lcov.info>
#   patch-coverage ../frontend-app-learning bsmith/outline-shared-modules bsmith/outline-tab \
#       ../frontend-app-learning/frontend-base/coverage/lcov.info
#
# A line whose only coverage is a branch never taken (a default parameter, for instance) is
# listed as partial here; codecov lists it as missed.
import subprocess, sys, collections

repo, base, head, lcov = sys.argv[1:5]
# lines added between base and head, per file
added = collections.defaultdict(set)
diff = subprocess.run(['git', '-C', repo, 'diff', '-U0', base, head, '--', 'frontend-base/src'], capture_output=True, text=True, check=True).stdout
path = None
for line in diff.splitlines():
    if line.startswith('+++ b/'):
        path = line[6:]
    elif line.startswith('@@') and path:
        plus = line.split('+')[1].split(' ')[0]
        start, _, count = plus.partition(',')
        for n in range(int(start), int(start) + int(count or 1)):
            added[path].add(n)

hits, branches = {}, {}
current = None
for line in open(lcov):
    line = line.strip()
    if line.startswith('SF:'):
        current = line[3:]
        hits[current], branches[current] = {}, collections.defaultdict(list)
    elif line.startswith('DA:'):
        n, h = line[3:].split(',')[:2]
        hits[current][int(n)] = int(h)
    elif line.startswith('BRDA:'):
        n, _, _, taken = line[5:].split(',')
        branches[current][int(n)].append(0 if taken == '-' else int(taken))

total = missed = partial = 0
report = collections.defaultdict(lambda: {'missed': [], 'partial': []})
for path, lines in added.items():
    if path not in hits:
        continue
    for n in sorted(lines):
        if n not in hits[path] and n not in branches[path]:
            continue
        total += 1
        h = hits[path].get(n, 1)
        br = branches[path].get(n, [])
        if h == 0:
            missed += 1; report[path]['missed'].append(n)
        elif br and any(b == 0 for b in br):
            partial += 1; report[path]['partial'].append(n)
print(f'patch: {total} lines, {missed} missed, {partial} partial, {100 * (total - missed - partial) / total:.2f}%')
for path in sorted(report):
    r = report[path]
    print(f"  {path.replace('frontend-base/src/', '')}: missed {r['missed']} partial {r['partial']}")
